---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { Header } from '../components/Header';
import { Sidebar } from '../components/Sidebar';
import { TableOfContents } from '../components/TableOfContents';
import { Breadcrumbs } from '../components/Breadcrumbs';
import { NAV_ITEMS, normalizePath } from '../lib/navigation';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    section?: string;
    order?: number;
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const currentPath = Astro.url.pathname;

// Build breadcrumbs from URL segments
const segments = currentPath.split('/').filter(Boolean);
const breadcrumbItems = [
  { label: 'Docs', href: '/' },
  ...segments.map((seg, i) => {
    const segmentPath = '/' + segments.slice(0, i + 1).join('/');
    const current = i === segments.length - 1;
    const hasRoute = NAV_ITEMS.some(item => normalizePath(item.href) === normalizePath(segmentPath));
    return {
      label: seg.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
      href: !current && hasRoute ? segmentPath : undefined,
      current,
    };
  }),
];

const currentIndex = NAV_ITEMS.findIndex(item => normalizePath(item.href) === normalizePath(currentPath));
const previousItem = currentIndex > 0 ? NAV_ITEMS[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 ? (NAV_ITEMS[currentIndex + 1] ?? null) : null;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <Header client:load />

  <div class="mx-auto flex max-w-[1440px] pt-14">
    <Sidebar currentPath={currentPath} client:load />

    <main id="main-content" tabindex="-1" class="min-w-0 flex-1 px-6 py-10 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <Breadcrumbs items={breadcrumbItems} />

        <article class="prose mt-8 max-w-none border-b border-zinc-900 pb-16">
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && (
            <p class="mt-1 mb-8 font-display text-[15px] text-text-secondary">{frontmatter.description}</p>
          )}
          <slot />
        </article>

        {(previousItem || nextItem) && (
          <nav aria-label="Document pagination" class="mt-12 flex flex-col gap-4 sm:flex-row sm:justify-between">
            {previousItem ? (
              <a
                href={previousItem.href}
                class="group flex min-w-[220px] flex-col items-start gap-2 rounded-lg border border-zinc-800 p-6 no-underline transition-all hover:border-accent/50 hover:bg-accent/5"
              >
                <span class="text-[10px] font-bold uppercase tracking-widest text-text-secondary">Previous</span>
                <span class="font-display font-bold text-zinc-100 transition-colors group-hover:text-accent">
                  ← {previousItem.title}
                </span>
              </a>
            ) : <span />}
            {nextItem && (
              <a
                href={nextItem.href}
                class="group flex min-w-[240px] cursor-pointer flex-col items-end gap-2 rounded-lg border border-zinc-800 p-6 no-underline transition-all hover:border-accent/50 hover:bg-accent/5"
              >
                <span class="text-[10px] font-bold uppercase tracking-widest text-text-secondary">Next Up</span>
                <span class="font-display font-bold text-zinc-100 transition-colors group-hover:text-accent">
                  {nextItem.title} →
                </span>
              </a>
            )}
          </nav>
        )}
      </div>
    </main>

    <TableOfContents headings={headings} client:load />
  </div>

  <Footer />
</BaseLayout>
