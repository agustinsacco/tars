---
import { TarsLogo } from './TarsLogo';

const LINKS = [
  { label: 'Docs', href: '/getting-started/installation' },
  { label: 'Security', href: '/capabilities/security' },
  { label: 'GitHub', href: 'https://github.com/agustinsacco/tars', external: true },
  { label: 'npm', href: 'https://www.npmjs.com/package/@saccolabs/tars', external: true },
  { label: 'Changelog', href: 'https://github.com/agustinsacco/tars/blob/main/CHANGELOG.md', external: true },
];
---

<footer class="border-t border-zinc-900">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between md:px-8">
    <div class="flex items-center gap-3">
      <TarsLogo size={24} />
      <p class="text-xs text-text-secondary">
        <span class="font-display text-sm font-bold text-zinc-200">TARS</span>
        <span class="mx-2 text-zinc-700">/</span>
        Self-hosted personal AI assistant. MIT licensed. Built by Agustin Sacco.
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-[11px] uppercase tracking-widest text-text-secondary">
      {LINKS.map((link) => (
        <a
          href={link.href}
          class="transition-colors hover:text-zinc-100"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
