---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/Header';
import { Sidebar } from '../components/Sidebar';
import { TarsLogo } from '../components/TarsLogo';
import { Terminal, Cpu, Brain, Puzzle, Zap, Clock } from 'lucide-react';
---

<BaseLayout title="TARS — Autonomous AI Assistant">
  <Header client:load />

  <div class="flex pt-14 max-w-[1440px] mx-auto">
    <Sidebar currentPath="/" client:load />

    <main class="flex-1 min-w-0 px-8 lg:px-12 py-12">
      <!-- Hero -->
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-4 mb-6">
          <TarsLogo size={48} />
          <div>
            <h1 class="text-3xl font-bold text-zinc-100 tracking-tight font-['Space_Grotesk']">TARS</h1>
            <p class="text-xs text-zinc-500 tracking-widest uppercase">Autonomous AI Assistant</p>
          </div>
        </div>

        <p class="text-zinc-400 text-sm leading-relaxed mb-4 max-w-2xl">
          The Autonomous Intelligence Layer for your local infrastructure. Tars is a locally-hosted AI agent powered by Google Gemini. Deploy it as a Personal Assistant, a Security Auditor, or a DevOps Engineer—or orchestrate your entire environment with multiple instances.
        </p>


        <div class="flex items-center gap-3 mb-10">
          <a href="/getting-started/what-is-tars" class="text-xs bg-blue-500/10 text-blue-400 border border-blue-500/20 px-4 py-2 rounded hover:bg-blue-500/20 transition-colors">
            Get Started →
          </a>
          <a href="/use-cases/personal-assistant" class="text-xs text-zinc-500 border border-zinc-800 px-4 py-2 rounded hover:text-zinc-300 hover:border-zinc-700 transition-colors">
            Explore Use Cases
          </a>
        </div>

        <!-- Feature Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Zap className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">Personal Assistant</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Tars manages your schedule, remembers preferences via persistent memory, and executes workflows directly from Discord.
            </p>
          </div>

          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Terminal className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">Host Manager</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Deploy Tars as a dedicated system administrator. It monitors health, manages logs, and executes maintenance tasks autonomously.
            </p>
          </div>

          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Brain className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">Security Auditor</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Analyze firewall and auth logs in real-time. Tars detects anomalies, summarizes incidents, and alerts you instantly.
            </p>
          </div>

          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Cpu className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">Multi-Instance</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Scale your automation by running multiple Tars instances, each bound to a unique Discord bot with specialized permissions.
            </p>
          </div>

          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Puzzle className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">MCP Protocol</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Full compatibility with the Model Context Protocol. Connect Tars to your internal APIs, databases, and custom tools.
            </p>
          </div>

          <div class="border border-zinc-800 rounded-md p-4 hover:border-zinc-700 transition-colors">
            <div class="flex items-center gap-2 mb-2">
              <Clock className="w-4 h-4 text-blue-400" />
              <h3 class="text-sm font-bold text-zinc-200">Always On</h3>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">
              Tars doesn't wait for you to prompt it. It runs on a continuous background loop, scheduling its own tasks and checking in when work is complete.
            </p>
          </div>
        </div>

        <!-- Quick Install -->
        <div class="mt-10 border border-zinc-800 rounded-md overflow-hidden">
          <div class="bg-[#0e0e10] px-4 py-2 border-b border-zinc-800 flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
            <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
            <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
            <span class="text-[10px] text-zinc-600 ml-2">terminal</span>
          </div>
          <div class="bg-[#0e0e10] p-4">
            <code class="text-sm text-zinc-300">
              <span class="text-zinc-500">$</span> npm install -g @saccolabs/tars<br/>
              <span class="text-zinc-500">$</span> tars setup<br/>
              <span class="text-zinc-500">$</span> tars start
            </code>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
